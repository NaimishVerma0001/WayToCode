# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# The previous REACT_APP_ prefix was a Create React App convention and was
# silently ignored, which left the production build with no API URL at all.

# Development: leave unset. `vite.config.js` proxies /api to the local backend.
# Production: required. Point this at the deployed API, including /api.
VITE_API_URL=https://way2code-api.onrender.com/api

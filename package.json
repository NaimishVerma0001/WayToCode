{
  "name": "waytocode",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack coding progress dashboard that aggregates developer profiles and upcoming contests across multiple platforms.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev:server & npm run dev:client",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:db": "npm run dev:db --workspace server",
    "start:server": "npm run start --workspace server",
    "build": "npm run build:client",
    "build:client": "npm run build --workspace client",
    "preview:client": "npm run preview --workspace client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --workspace server",
    "test:server:coverage": "npm run test:coverage --workspace server",
    "test:server:watch": "npm run test:watch --workspace server",
    "test:client": "npm run test --workspace client",
    "test:client:coverage": "npm run test:coverage --workspace client",
    "test:client:watch": "npm run test:watch --workspace client",
    "test:e2e": "npm run test:e2e --workspace server",
    "verify": "npm run lint && npm test && npm run test:e2e && npm run build:client"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0"
  }
}

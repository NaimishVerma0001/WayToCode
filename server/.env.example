# server/.env.example
# Copy to server/.env and fill in the values. Never commit the real file.

# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ── Database (required) ───────────────────────────────────────────────────
# Must start with mongodb:// or mongodb+srv://.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/way2code

# ── Authentication (required) ─────────────────────────────────────────────
# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_of_32_chars_or_more

# Short-lived access token; the refresh token lives in an HttpOnly cookie.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor for new signups (10-14).
BCRYPT_ROUNDS=12

# ── CORS & WebSockets (required in production) ────────────────────────────
# Comma-separated origins. Production must use https.
CLIENT_URL=http://localhost:3000

# ── Registration one-time codes ───────────────────────────────────────────
# At least 32 characters, and required in production: without it, signup
# fails at the OTP step. Locally, codes are printed to the console instead.
REGISTRATION_OTP_SECRET=

# ── Email delivery ────────────────────────────────────────────────────────
# All four of SMTP_HOST, SMTP_USER, SMTP_PASS and EMAIL_FROM are required in
# production. Leave blank locally to log emails to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Way2Code <your_email@gmail.com>

# ── Optional integrations ─────────────────────────────────────────────────
# Raises the GitHub API rate limit for profile lookups (unauthenticated
# requests are capped at 60/hour per IP). Needs no scopes for public data.
GITHUB_TOKEN=
